{
  "name": "@vjymisal0/upi-link",
  "version": "0.1.6",
  "description": "Create and parse UPI payment deep links with zero runtime dependencies.",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./src/index.d.cts",
        "default": "./src/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "upi",
    "india",
    "payments",
    "payment-link",
    "deep-link",
    "npci",
    "qr",
    "bhim",
    "payment-request",
    "upi-intent"
  ],
  "author": "vjymisal0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vjymisal0/upi-link"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/vjymisal0/upi-link#readme",
  "bugs": {
    "url": "https://github.com/vjymisal0/upi-link/issues"
  }
}
